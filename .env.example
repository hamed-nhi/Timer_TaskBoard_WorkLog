# copy to .env on the server (never commit .env)
DB_PASSWORD=change-me-long-random
# domain for automatic https, or ":80" for plain http
SITE_ADDRESS=:80
# empty = automatic: Secure cookie on HTTPS, regular cookie on HTTP
COOKIE_SECURE=
HTTP_PORT=80
# optional mirrors for servers inside Iran, e.g. DOCKER_REGISTRY=docker.arvancloud.ir/
DOCKER_REGISTRY=
NPM_REGISTRY=https://registry.npmjs.org
PIP_INDEX_URL=https://pypi.org/simple
# backup passphrase (deploy/backup.sh); keep a copy somewhere safe, backups are useless without it
BACKUP_PASSPHRASE=change-me-too

# Optional Sheets sync for personal-backup; mount ./secrets/google-sheets.json read-only.
GOOGLE_APPLICATION_CREDENTIALS=
# When configured: /run/secrets/google-sheets.json

# Login protection is enforced by PostgreSQL/backend, even when CAPTCHA_PROVIDER=none.
CAPTCHA_PROVIDER=none
# Optional Iranian ARCaptcha; set provider=arcaptcha only after obtaining both keys.
ARCAPTCHA_SITE_KEY=
ARCAPTCHA_SECRET_KEY=
LOGIN_IP_BURST=30
LOGIN_IP_HOURLY=120
LOGIN_GLOBAL_PER_MINUTE=300

# Public service-account email shown in personal backup setup; never its private key.
GOOGLE_SHEETS_SERVICE_EMAIL=
