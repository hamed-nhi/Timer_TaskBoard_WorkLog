# SITE_ADDRESS: ":80" for plain http (behind another proxy / testing) or a domain name for automatic https
{$SITE_ADDRESS::80} {
	encode gzip
	handle /api/* {
		request_body {
			max_size 8MB
		}
		reverse_proxy {$API_UPSTREAM:api:8000}
	}
	handle {
		root * /srv
		try_files {path} {path}/index.html
		file_server
	}
	header {
		import /etc/caddy/security-headers.caddy
		-Server
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options DENY
	}
}
